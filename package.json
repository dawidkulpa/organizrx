{
  "name": "organizrx",
  "version": "0.0.1",
  "description": "OrganizrX - intelligent automation orchestration platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:server dev:web",
    "dev:server": "cd apps/server && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "build": "bun run build:server && bun run build:web",
    "build:server": "cd apps/server && bun run build",
    "build:web": "cd apps/web && bun run build",
    "test": "bun test",
    "e2e:test": "npx playwright test --config=e2e/playwright.config.ts",
    "check": "bun run check:server && bun run check:web",
    "check:server": "cd apps/server && bunx tsc --noEmit",
    "check:web": "cd apps/web && bunx tsc --noEmit",
    "lint": "bun run lint:root && bun run lint:server && bun run lint:web",
    "lint:root": "eslint . --no-warn-ignored",
    "lint:server": "cd apps/server && bun run lint",
    "lint:web": "cd apps/web && bun run lint",
    "create-plugin": "bun run scripts/create-plugin.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.58.2",
    "eslint": "^10.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.0"
  }
}
